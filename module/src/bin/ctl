#!/system/bin/sh
# ============================================================
#  bin/ctl —— 稳定入口（shim）
#
#  ⚠️ 必须用 dirname "$0" 定位自身：PATH 内没有 thermo，
#     直接 `exec thermo ctl` 会找不到命令。
#
#  保留本 shim 的意义：客户端（WebUI / APP）通过 `sh bin/ctl ...`
#  调用后端，切换实现时前端零改动。
# ============================================================

MODDIR=${0%/*}
exec "$MODDIR/thermo" ctl "$@"
