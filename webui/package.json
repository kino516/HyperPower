{
  "name": "hyperpower-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "澎湃充控 HyperPower 的 WebUI（KernelSU / APatch 模块内运行）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node check-style-dup.mjs && node check-component-import.mjs && node check-html-comment.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:styles": "node check-style-dup.mjs",
    "check:components": "node check-component-import.mjs",
    "check:html": "node check-html-comment.mjs"
  },
  "dependencies": {
    "kernelsu": "^3.0.2",
    "miuix-vue": "^0.1.1",
    "motion-v": "^2.7.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^5.4.10",
    "vue-tsc": "^3.3.13"
  }
}
